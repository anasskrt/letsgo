# Configuration de l'ingestion (partie ingestion d'API publiques)

# nombre de jours d'historique a recuperer (au moins 30)
INGEST_DAYS=35

# nombre de stations recuperees en parallele (taille du pool de workers)
INGEST_WORKERS=4

# limite d'appels par seconde vers Open-Meteo (throttling)
INGEST_RATE=5
